{
  "expo": {
    "name": "AsonyxAI",
    "slug": "AsonyxAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "asonyxai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asonyx.ai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#062320",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.asonyx.ai",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Asonyx AI to use this phone's camera for ride safety photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "24496fc0-4f74-4e72-82bd-ad965a65710c"
      }
    }
  }
}
