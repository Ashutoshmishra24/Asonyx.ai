# Start safely: the buzzer works, but no real SMS is sent until this is false.
DRY_RUN=true

# ADXL345 on Raspberry Pi I2C bus 1. Common addresses are 0x53 and 0x1D.
ADXL345_I2C_BUS=1
ADXL345_ADDRESS=0x53

# Active buzzer module signal pin (BCM numbering).
BUZZER_ENABLED=true
BUZZER_GPIO=17
BUZZER_ACTIVE_HIGH=true

# Alarm tuning. Tilt must persist before an SMS is sent.
TILT_THRESHOLD_DEGREES=55
TILT_HOLD_SECONDS=2
RESET_THRESHOLD_DEGREES=20
RESET_HOLD_SECONDS=5
ALERT_COOLDOWN_SECONDS=300
SAMPLE_INTERVAL_SECONDS=0.1
CALIBRATION_SAMPLES=50

# MQ-3 module. Use "digital" for its DO pin, or "mcp3008" for AO through an ADC.
MQ3_ENABLED=true
MQ3_MODE=digital
MQ3_DIGITAL_GPIO=27
MQ3_DIGITAL_ACTIVE_LOW=true
MQ3_ADC_CHANNEL=0

# Digital mode returns 0 or 1, so these defaults work for both supported modes.
# Tune analog thresholds only after observing sober baseline readings.
MQ3_THRESHOLD=0.55
MQ3_CLEAR_THRESHOLD=0.40
MQ3_HOLD_SECONDS=3
MQ3_CLEAR_HOLD_SECONDS=30
MQ3_REPEAT_SMS_SECONDS=60
MQ3_WARMUP_SECONDS=60
MQ3_SAMPLE_INTERVAL_SECONDS=0.2

# Offline voice assistant. Run download_voice_model.py once before enabling.
VOICE_ASSISTANT_ENABLED=true
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
MUSIC_FILE=media/demo.mp3
VOICE_SAMPLE_RATE=16000
# Leave blank to use the system defaults. Use voice_assistant.py --list-devices
# for the input ID/name; ALSA output examples include plughw:2,0.
VOICE_INPUT_DEVICE=
VOICE_OUTPUT_DEVICE=
VOICE_SOS_COOLDOWN_SECONDS=300

# Common 3-pin touch-switch module: OUT to BCM GPIO22, active HIGH.
# For a plain mechanical button wired between GPIO22 and GND, set this true.
EMERGENCY_BUTTON_ENABLED=true
EMERGENCY_BUTTON_GPIO=22
EMERGENCY_BUTTON_ACTIVE_LOW=false
EMERGENCY_BUTTON_BOUNCE_SECONDS=0.15
EMERGENCY_COUNTDOWN_SECONDS=8

HELMET_OWNER_NAME=Rider

# Twilio trial credentials and E.164 phone numbers, for example +919876543210.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_TO_NUMBERS=
