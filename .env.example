# Firebase/Google OAuth values used by the app. Do not put OAuth client secrets here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-android-example.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-ios-example.apps.googleusercontent.com

# Optional public Firebase web-app identifiers. Native Android/iOS Firebase uses
# google-services.json and GoogleService-Info.plist instead.
EXPO_PUBLIC_FIREBASE_API_KEY=your-public-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:example
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EXAMPLE
